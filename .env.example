# Server-only. Never prefix this key with NEXT_PUBLIC_.
SERPAPI_API_KEY=

# Tavily powers the bounded research agent (server-only).
TAVILY_API_KEY=

# Nexconn: use credentials from the same app/environment.
# All three are read server-side. Only the App Key reaches authorized clients.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_REGION=SG
# Optional override: HTTPS API domain from your Nexconn console.
# NEXCONN_API_BASE_URL=https://api.sg-light-api.com
# Local rehearsal is enabled in development only by default.
# ACCESSPROOF_ENABLE_REHEARSAL=true

# Hosting: Firestore persists rooms across Cloud Run restarts.
# ACCESSPROOF_STORAGE=firestore
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_CLOUD_PROJECT=your-project
# ACCESSPROOF_DEMO_PASSWORD=your-private-demo-passphrase
